# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Access Control ─────────────────────────────────────────────
# 允许登录的 unionId 白名单（逗号分隔；配置时把 owner 一并列入）。
# 留空时：仅 OWNER_UNION_ID 可登录；OWNER_UNION_ID 也留空 = 不限制（自托管默认）。
ALLOWED_UNION_IDS=

# ── AI 服务商（密钥仅服务端使用，绝不下发浏览器）──────────────────
# 方式一：单一默认服务商（OpenAI 兼容协议即可：Moonshot/DeepSeek/OpenRouter/自部署 vLLM 等）
KIMI_AGENTGW_BASE_URL=    # e.g. https://api.moonshot.cn/v1 或 https://api.kimi.com/coding/v1
KIMI_AGENTGW_API_KEY=
AI_PROVIDER_DEFAULT_NAME= # 可选：默认服务商在界面显示的名称
AI_PROVIDER_DEFAULT_MODEL=# 可选：显式默认模型 id（第三方 /models 常无 default_model_id）
# 方式二：多服务商（JSON 数组；配置后页面顶栏出现切换器，每个用户自选走哪家）
# 每项：{"name": "显示名", "baseUrl": "…/v1", "apiKey": "sk-…", "defaultModel": "可选"}
AI_PROVIDERS=

# ── Ops ─────────────────────────────────────────────────────────
# npm run healthcheck 的体检目标。只写本地 .env，勿提交仓库。
SITE_URL=
